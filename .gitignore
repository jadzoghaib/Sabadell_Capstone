# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.env
*.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — track processed samples, models, and ALL results so teammates can
# pull and explore without re-running notebooks. Only exclude what's too big
# for GitHub or trivially regenerable. (NOTE: gitignore has no inline comments —
# every comment must be on its own line, or it becomes part of the pattern.)

# Source LendingClub dumps (huge)
data/raw/*
!data/raw/.keep

data/interim/*

# 109MB — over GitHub's 100MB hard limit; regenerate via 02_Preprocessing
data/processed/02_processed_data.npz

# models/ and data/results/ are intentionally NOT ignored — they're small and
# needed for collaboration (run_ml_on_sample loads models/xgb_model.joblib etc.)

# Huge model weights (none currently — guard for future deep nets)
*.pt
*.pth
*.onnx

# Logs & outputs
logs/
*.log
mlruns/
wandb/
.neptune/
outputs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local config (per-user tooling — skills, settings — not project code)
.claude/
